# Copie para .env.local para rodar localmente. No Vercel, configure em
# Project Settings > Environment Variables.

# Login da área /lista (formato usuario:senha)
LOGIN_LEONARDO=leonardo:troque-esta-senha
LOGIN_FLAVIA=flavia:troque-esta-senha

# Upstash Redis — criadas automaticamente pela integração Upstash do Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mail de aviso (Resend)
RESEND_API_KEY=
NOTIFY_EMAILS=leonardo.xavierj@gmail.com,flavia.enriquez@gmail.com
# Opcional: remetente de um domínio verificado no Resend
# EMAIL_FROM=Théo 5 anos <convite@seudominio.com.br>

# Opcional: preenchimento automático do cadastro manual
ANTHROPIC_API_KEY=

# Opcional: endereço público do site (se usar domínio próprio)
# SITE_URL=https://theo5anos.com.br
